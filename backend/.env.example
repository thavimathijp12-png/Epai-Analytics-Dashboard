# MongoDB Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/employee_intelligence?retryWrites=true&w=majority
MONGODB_URI=<your_mongodb_connection_string>

# JWT Secret for Authentication
JWT_SECRET=<your_secure_jwt_secret_key>

# Backend Server Port
PORT=5000

# (Optional) Restrict CORS to a specific frontend URL in production
FRONTEND_URL=<your_frontend_url_e_g_https://your-app.onrender.com>
